  "text.onWarningSubtle": {
    "light": "{status.textOnWarningSubtle.light}",
    "dark": "{status.textOnWarningSubtle.dark}"
  },
  "text.onAlarmSubtle": {
    "light": "{status.textOnAlarmSubtle.light}",
    "dark": "{status.textOnAlarmSubtle.dark}"
  },
  "action.primary": {
    "light": "{color.roles.actionPrimary.light}",
    "dark": "{color.roles.actionPrimary.dark}"
  },
  "action.pressed": {
    "light": "mix({semantic.action.primary}, {semantic.text.onBrand}, 0.16)",
    "dark": "mix({semantic.action.primary}, {semantic.text.onBrand}, 0.16)"
  },
  "action.subtle": {
    "light": "{color.roles.actionSubtle.light}",
    "dark": "{color.roles.actionSubtle.dark}"
  },
  "focus.indicator": {
    "light": "{semantic.action.primary}",
    "dark": "{semantic.action.primary}"
  },
  "status.moving": {
    "light": "{status.moving.light}",
    "dark": "{status.moving.dark}"
  },
  "status.parked": {
    "light": "{status.parked.light}",
    "dark": "{status.parked.dark}"
  },
  "status.warning": {
    "light": "{status.warning.light}",
    "dark": "{status.warning.dark}"
  },
  "status.alarm": {
    "light": "{status.alarm.light}",
    "dark": "{status.alarm.dark}"
  },
  "status.offline": {
    "light": "{status.offline.light}",
    "dark": "{status.offline.dark}"
  },
  "status.movingSubtle": {
    "light": "{status.statusMovingSubtle.light}",
    "dark": "mix({semantic.surface.content}, {semantic.status.moving}, 0.16)"
  },
  "status.warningSubtle": {
    "light": "{status.statusWarningSubtle.light}",
    "dark": "mix({semantic.surface.content}, {semantic.status.warning}, 0.16)"
  },
  "status.alarmSubtle": {
    "light": "{status.statusAlarmSubtle.light}",
    "dark": "mix({semantic.surface.content}, {semantic.status.alarm}, 0.16)"
  },
  "map.trackDefault": {
    "light": "{semantic.action.primary}",
    "dark": "{semantic.action.primary}"
  },
  "map.trackSpeeding": {
    "light": "{semantic.status.alarm}",
    "dark": "{semantic.status.alarm}"
  },
  "map.trackSelected": {
    "light": "{semantic.text.primary}",
    "dark": "{semantic.text.primary}"
  },
  "map.markerFill": {
    "light": "{semantic.surface.content}",
    "dark": "{semantic.surface.content}"
  },
  "map.markerStroke": {
    "light": "{semantic.text.primary}",
    "dark": "{semantic.text.primary}"
  },
  "map.clusterFill": {
    "light": "{semantic.surface.overlay}",
    "dark": "{semantic.surface.overlay}"
  },
  "map.clusterText": {
    "light": "{semantic.text.primary}",
    "dark": "{semantic.text.primary}"
  },
  "map.controlFill": {
    "light": "{map.chrome.fill}",
    "dark": "{map.chrome.fill}"
  },
  "map.controlBorder": {
    "light": "{map.chrome.border}",
    "dark": "{map.chrome.border}"
  },
  "map.controlDivider": {
    "light": "{map.chrome.divider}",
    "dark": "{map.chrome.divider}"
  },
  "map.controlInk": {
    "light": "{map.chrome.ink}",
    "dark": "{map.chrome.ink}"
  },
  "map.attributionInk": {
    "light": "{map.chrome.inkMuted}",
    "dark": "{map.chrome.inkMuted}"
  },
