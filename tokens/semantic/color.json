  "text.primary": {
    "light": "{color.roles.textPrimary.light}",
    "dark": "{color.roles.textPrimary.dark}"
  },
  "text.secondary": {
    "light": "{color.roles.textSecondary.light}",
    "dark": "{color.roles.textSecondary.dark}"
  },
  "text.disabled": {
    "light": "{color.roles.textDisabled.light}",
    "dark": "{color.roles.textDisabled.dark}"
  },
  "text.onBrand": {
    "light": "{color.roles.textOnBrand.light}",
    "dark": "{color.roles.textOnBrand.dark}"
  },
  "text.onMovingSubtle": {
    "light": "{status.textOnMovingSubtle.light}",
    "dark": "{status.textOnMovingSubtle.dark}"
