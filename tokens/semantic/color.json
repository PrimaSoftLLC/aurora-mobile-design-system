  "border.hairline": {
    "light": "{color.roles.borderHairline.light}",
    "dark": "{color.roles.borderHairline.dark}"
  },
  "border.strong": {
    "light": "{color.roles.borderStrong.light}",
    "dark": "{color.roles.borderStrong.dark}"
