{
  "surface.ground": {
    "light": "{color.roles.surfaceGround.light}",
    "dark": "{color.roles.surfaceGround.dark}"
  },
  "surface.content": {
    "light": "{color.roles.surfaceContent.light}",
    "dark": "{color.roles.surfaceContent.dark}"
  },
  "surface.chrome": {
    "light": "{color.roles.surfaceChrome.light}",
    "dark": "{color.roles.surfaceChrome.dark}"
  },
  "surface.selected": {
    "light": "{color.roles.surfaceSelected.light}",
    "dark": "{color.roles.surfaceSelected.dark}"
  },
  "surface.overlay": {
    "light": "{color.roles.surfaceOverlay.light}",
    "dark": "{color.roles.surfaceOverlay.dark}"
  },
  "surface.scrim": {
    "light": "alpha({color.neutral.1000}, 0.4)",
    "dark": "alpha({color.neutral.1000}, 0.6)"
