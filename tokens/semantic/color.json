    "dark": "alpha({geofence.green}, 0.35)"
  },
  "geofence.orange": {
    "light": "alpha({geofence.orange}, 0.25)",
    "dark": "alpha({geofence.orange}, 0.35)"
  },
  "geofence.purple": {
    "light": "alpha({geofence.purple}, 0.25)",
